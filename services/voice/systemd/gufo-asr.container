# Gufo asr server on the AMD GPU, the systemd form of gufo.sh asr.
# Another model: systemctl --user edit gufo-asr, then a [Container]
# section with an empty Exec= line and a new Exec= line.

[Unit]
Description=Gufo asr server (port 8881)

[Container]
Image=ghcr.io/gufo-org/toolboxes/gufo-runtime:latest
ContainerName=gufo-asr
Network=ai-net-intern.network
Network=ai-net-offline.network
Volume=/var/models:/var/models:ro
Device=/dev/kfd
Device=/dev/dri
UserNS=keep-id
GroupAdd=keep-groups
ReadOnly=true
Tmpfs=/tmp
DropCapability=all
NoNewPrivileges=true
SecurityLabelDisable=true
Exec=gufo serve --host 0.0.0.0 --port 8881 asr --model /var/models/Qwen/Qwen3-ASR-1.7B --served-model-name gufo
PublishPort=127.0.0.1:8881:8881

[Service]
Restart=on-failure
# The first start pulls an image of several GB.
TimeoutStartSec=900
