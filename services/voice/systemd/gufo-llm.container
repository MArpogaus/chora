[Unit]
Description=Gufo llm server (port 8888)

[Container]
Image=ghcr.io/gufo-org/toolboxes/gufo-runtime:latest@sha256:af997f31d5a825ad02fd44cbb6744e71a21df6149c02c5ed3bb0bb843b3f0013
ContainerName=gufo-llm
Network=ai-net-intern.network
Network=ai-net-offline.network
Volume=/var/models:/var/models:ro
AddDevice=/dev/kfd
AddDevice=/dev/dri
UserNS=keep-id
GroupAdd=keep-groups
ReadOnly=true
DropCapability=all
NoNewPrivileges=true
# Without it, SELinux denies the container the GPU devices.
SecurityLabelDisable=true
Exec=gufo serve --host 0.0.0.0 --port 8888 llm --model /var/models/gufo-llm --served-model-name gufo
PublishPort=127.0.0.1:8888:8888

[Service]
Restart=on-failure
