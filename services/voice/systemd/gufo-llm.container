# Gufo llm server on the AMD GPU, the systemd form of gufo.sh llm.
# Another model: systemctl --user edit gufo-llm, then a [Container]
# section with an empty Exec= line and a new Exec= line.

[Unit]
Description=Gufo llm server (port 8888)

[Container]
Image=ghcr.io/gufo-org/toolboxes/gufo-runtime:latest
ContainerName=gufo-llm
Network=ai-net-intern.network
Network=ai-net-offline.network
Volume=/var/models:/var/models:ro
Device=/dev/kfd
Device=/dev/dri
UserNS=keep-id
GroupAdd=keep-groups
ReadOnly=true
Tmpfs=/tmp
DropCapability=all
NoNewPrivileges=true
SecurityLabelDisable=true
Exec=gufo serve --host 0.0.0.0 --port 8888 llm --model /var/models/gufo-llm --served-model-name gufo
PublishPort=127.0.0.1:8888:8888

[Service]
Restart=on-failure
# The first start pulls an image of several GB.
TimeoutStartSec=900
