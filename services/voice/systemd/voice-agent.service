# The voice agent as a user service of the graphical session, which
# brings PipeWire and, under chora, CHORA_SOCKET.

[Unit]
Description=Chora voice agent
PartOf=graphical-session.target
Wants=gufo-asr.service gufo-tts.service gufo-llm.service
After=graphical-session.target gufo-asr.service gufo-tts.service gufo-llm.service

[Service]
# uv and choractl, which the user manager does not find by default.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=%h/Projekte/chora/services/voice/agent.py
EnvironmentFile=-%h/.config/gufo/agent.env
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
