# Gufo tts server on the AMD GPU, the systemd form of gufo.sh tts.

[Unit]
Description=Gufo tts server (port 8882)

[Container]
Image=ghcr.io/gufo-org/toolboxes/gufo-runtime:latest
ContainerName=gufo-tts
Network=ai-net-intern.network
Network=ai-net-offline.network
Volume=/var/models:/var/models:ro
Device=/dev/kfd
Device=/dev/dri
UserNS=keep-id
GroupAdd=keep-groups
ReadOnly=true
DropCapability=all
NoNewPrivileges=true
# Without it, SELinux denies the container the GPU devices.
SecurityLabelDisable=true
Exec=gufo serve --host 0.0.0.0 --port 8882 tts --model /var/models/Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice --served-model-name gufo
PublishPort=127.0.0.1:8882:8882

[Service]
Restart=on-failure
# The first start pulls an image of several GB.
TimeoutStartSec=900
