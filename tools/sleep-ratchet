#!/bin/sh
# Sleep ratchet (F4, W9): the count of sleep lines in the gate scripts may only fall.
#
# Usage: tools/sleep-ratchet [--root DIR] [--update]
#   --root DIR  the repository to check (default: the one holding this tool)
#   --update    rewrite tools/sleep-ratchet.list with the count of the tree
#
# The count, by the command of the audit (reports/audit-f.md r6, row W9):
#   grep -h -E '(^|[^a-z_])sleep ' tests/*.sh | wc -l
# `sleep` is that count and stays 779 (the RC value): tests/*.sh only, every
# line with the word followed by a space, a comment included.
# `sleep-all` also counts `time.sleep(` lines (embedded python) and the
# subdirectories of tests/ (up to two levels: tests/battle, tests/doors, ...).
# tools/sleep-ratchet.list holds `sleep COUNT` and `sleep-all COUNT`, `#` starts a comment. The count
# only falls: a wait that a gate needs is a poll loop on a condition, not a new
# line. --update only lowers (it fails when a count is above the list); a raise
# of the list is made by hand and needs a `ratchet-raise:` line in the commit message.
# Fails (status 1) when the count is above the list, naming the list value, the
# tree value and the 5 files that add the most; a count below only prints
# "lower the list": run --update. Status 0 ok, 1 breach, 2 usage.
set -eu

root=$(cd "$(dirname "$0")/.." && pwd)
update=0
while [ $# -gt 0 ]; do
    case $1 in
    --root) root=$(cd "${2:?--root needs a directory}" && pwd); shift ;;
    --update) update=1 ;;
    -h | --help) sed -n '2,/^set -eu/p' "$0" | sed '$d;s/^# \{0,1\}//'; exit 0 ;;
    *) echo "usage: tools/sleep-ratchet [--root DIR] [--update]" >&2; exit 2 ;;
    esac
    shift
done
cd "$root"

count_lines() {
    for f in "$@"; do
        [ -f "$f" ] || continue
        n=$(grep -c -E "$pattern" "$f" || true)
        if [ "$n" -gt 0 ]; then echo "$f $n"; fi
    done
}
summarize() {
    count=$(printf '%s\n' "$1" | awk 'NF { n += $2 } END { print n + 0 }')
    top_files=$(printf '%s\n' "$1" | awk 'NF { print $2, $1 }' |
        LC_ALL=C sort -k1,1nr -k2,2 | head -5 |
        awk '{ printf "%s%s (%s)", sep, $2, $1; sep = ", " } END { print "" }')
}

pattern='(^|[^a-z_])sleep '
per_file=$(count_lines tests/*.sh)
summarize "$per_file"
count_audit=$count
top_audit=$top_files
pattern='(^|[^a-z_])sleep |time\.sleep\('
per_file=$(count_lines tests/*.sh tests/*/*.sh tests/*/*/*.sh)
summarize "$per_file"
count_all=$count
top_all=$top_files

list=tools/sleep-ratchet.list
list_value() { sed 's/#.*//' "$list" 2>/dev/null | awk -v k="$1" '$1 == k { print $2 }'; }
if [ "$update" = 1 ]; then
    for pair in "sleep $count_audit" "sleep-all $count_all"; do
        set -- $pair
        max=$(list_value "$1")
        if [ -n "$max" ] && [ "$2" -gt "$max" ]; then
            echo "FAIL: sleep-ratchet: $1 is $2, above the list value $max; --update only lowers."
            echo "  raise by hand with a ratchet-raise: <reason> line in the commit message"
            exit 1
        fi
    done
    {
        echo "# Sleep lines of tests (tools/sleep-ratchet). The counts only fall."
        echo "sleep $count_audit"
        echo "sleep-all $count_all"
    } >"$list"
    exit 0
fi

status=0
for pair in "sleep $count_audit" "sleep-all $count_all"; do
    set -- $pair
    name=$1 count=$2
    max=$(list_value "$name")
    if [ "$name" = sleep ]; then top=$top_audit; else top=$top_all; fi
    if [ -z "$max" ]; then
        echo "FAIL: sleep-ratchet: $name is not in $list"
        status=1
    elif [ "$count" -gt "$max" ]; then
        echo "FAIL: sleep-ratchet: $name is $count, the list holds $max"
        echo "  $name: list $max, tree $count; most in: $top"
        status=1
    elif [ "$count" -lt "$max" ]; then
        echo "lower the list: $name is $count, listed $max; run tools/sleep-ratchet --update"
    fi
done
[ "$status" = 0 ] || exit 1
echo "ok: sleep-ratchet (sleep $count_audit, sleep-all $count_all)"
