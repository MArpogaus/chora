#!/bin/sh
# Sleep ratchet (F4, W9): the count of sleep lines in the gate scripts may only fall.
#
# Usage: tools/sleep-ratchet [--root DIR] [--update]
#   --root DIR  the repository to check (default: the one holding this tool)
#   --update    rewrite tools/sleep-ratchet.list with the count of the tree
#
# The count, by the command of the audit (reports/audit-f.md r6, row W9):
#   grep -h -E '(^|[^a-z_])sleep ' tests/*.sh | wc -l
# It reads tests/*.sh only (not subdirectories) and counts every line with the
# word followed by a space, a comment included.
# tools/sleep-ratchet.list holds `sleep COUNT`, `#` starts a comment. The count
# only falls: a wait that a gate needs is a poll loop on a condition, not a new
# line. A raise of the list needs a `ratchet-raise:` line in the commit message.
# Fails (status 1) when the count is above the list, naming the list value, the
# tree value and the 5 files that add the most; a count below only prints
# "lower the list": run --update. Status 0 ok, 1 breach, 2 usage.
set -eu

root=$(cd "$(dirname "$0")/.." && pwd)
update=0
while [ $# -gt 0 ]; do
    case $1 in
    --root) root=$(cd "${2:?--root needs a directory}" && pwd); shift ;;
    --update) update=1 ;;
    -h | --help) sed -n '2,/^set -eu/p' "$0" | sed '$d;s/^# \{0,1\}//'; exit 0 ;;
    *) echo "usage: tools/sleep-ratchet [--root DIR] [--update]" >&2; exit 2 ;;
    esac
    shift
done
cd "$root"

per_file=$(
    for f in tests/*.sh; do
        [ -f "$f" ] || continue
        n=$(grep -c -E '(^|[^a-z_])sleep ' "$f" || true)
        if [ "$n" -gt 0 ]; then echo "$f $n"; fi
    done
)
count=$(printf '%s\n' "$per_file" | awk 'NF { n += $2 } END { print n + 0 }')
top_files=$(printf '%s\n' "$per_file" | awk 'NF { print $2, $1 }' |
    LC_ALL=C sort -k1,1nr -k2,2 | head -5 |
    awk '{ printf "%s%s (%s)", sep, $2, $1; sep = ", " } END { print "" }')

list=tools/sleep-ratchet.list
if [ "$update" = 1 ]; then
    {
        echo "# Sleep lines of tests/*.sh (tools/sleep-ratchet). The count only falls."
        echo "sleep $count"
    } >"$list"
    exit 0
fi

max=$(sed 's/#.*//' "$list" 2>/dev/null | awk '$1 == "sleep" { print $2 }')
if [ -z "$max" ]; then
    echo "FAIL: sleep-ratchet: sleep is not in $list"
    exit 1
elif [ "$count" -gt "$max" ]; then
    echo "FAIL: sleep-ratchet: sleep is $count, the list holds $max"
    echo "  sleep: list $max, tree $count; most in: $top_files"
    exit 1
elif [ "$count" -lt "$max" ]; then
    echo "lower the list: sleep is $count, listed $max; run tools/sleep-ratchet --update"
fi
echo "ok: sleep-ratchet (sleep $count)"
