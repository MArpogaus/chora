#!/bin/sh
# post-checkout: keeps the PM's log worktree on claude/session-log (friction 23, 44).
# Installed into the shared hooks directory by tools/install_hooks.sh; acts only in that worktree.
log=${PM_LOG:-/home/user/wt/log}
top=$(git rev-parse --show-toplevel 2>/dev/null)
[ "$top" = "$(cd "$log" 2>/dev/null && pwd -P)" ] || [ "$top" = "$log" ] || exit 0
[ "$(git symbolic-ref --short -q HEAD)" = claude/session-log ] && exit 0
echo "post-checkout: $top must stay on claude/session-log; switching back." >&2
echo "post-checkout: for another branch use git worktree add /home/user/wt/<name> <branch>." >&2
git checkout -q claude/session-log >&2 || echo "post-checkout: switch back FAILED; fix by hand" >&2
exit 0
