#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# The startup command of a chora session: imports the variables of chora
# into the systemd user manager, tells systemd that chora is ready, and
# starts the target of a flavor. Under uwsm, `uwsm finalize` does the
# import and the notification (D50). Not for nested use: the variables
# would reach the units of the host session.
# Usage: chora -- chora-flavor NAME
set -eu

name=${1:?usage: chora-flavor NAME}

dir=
for candidate in "${XDG_CONFIG_HOME:-$HOME/.config}/chora/flavors/$name" \
    "/usr/share/chora/flavors/$name"; do
    if [ -d "$candidate" ]; then
        dir=$candidate
        break
    fi
done
if [ -z "$dir" ]; then
    echo "chora-flavor: no flavor $name" >&2
    exit 1
fi

# The units of the flavor read their files from this directory.
CHORA_FLAVOR_DIR=$dir
export CHORA_FLAVOR_DIR
variables="WAYLAND_DISPLAY CHORA_SOCKET CHORA_FLAVOR_DIR XDG_CURRENT_DESKTOP XDG_SESSION_TYPE"
# The X11 display of chora-xwayland, chosen now, so that every unit of the
# flavor starts with it.
if command -v xwayland-satellite >/dev/null; then
    n=0
    while [ -e "/tmp/.X11-unix/X$n" ] || [ -e "/tmp/.X$n-lock" ]; do
        n=$((n + 1))
    done
    DISPLAY=:$n
    export DISPLAY
    variables="$variables DISPLAY"
fi

# The units of the flavor, linked until the next boot.
for unit in "$dir"/*.service "$dir"/*.target; do
    if [ -e "$unit" ]; then
        systemctl --user link --runtime --force "$unit" >/dev/null
    fi
done
systemctl --user daemon-reload

if grep -q 'wayland-wm@' /proc/self/cgroup; then
    # uwsm runs chora as wayland-wm@chora.service. finalize also puts the
    # variables on the list that uwsm removes at the end of the session.
    # shellcheck disable=SC2086 # one word per variable name
    uwsm finalize $variables
else
    # shellcheck disable=SC2086
    systemctl --user import-environment $variables
    if command -v dbus-update-activation-environment >/dev/null; then
        # shellcheck disable=SC2086
        dbus-update-activation-environment --systemd $variables
    fi
    if [ -n "${NOTIFY_SOCKET:-}" ]; then
        systemd-notify --ready
    fi
fi
# A portal of an earlier session in the same user manager chose its
# backends for another XDG_CURRENT_DESKTOP; the next call starts it anew
# with the variables of chora, so screen sharing goes through
# chora-portals.conf (D37). Another graphical session of the user that
# is still open (active or online, not closing) shares the portal, so
# then the portal stays.
other=
for session in $(loginctl show-user "$(id -u)" -p Sessions --value 2>/dev/null); do
    [ "$session" != "${XDG_SESSION_ID:-}" ] || continue
    type=$(loginctl show-session "$session" -p Type --value 2>/dev/null) || true
    state=$(loginctl show-session "$session" -p State --value 2>/dev/null) || true
    case "$type $state" in
    "wayland active" | "wayland online" | "x11 active" | "x11 online") other=$session ;;
    esac
done
if [ -z "$other" ]; then
    systemctl --user stop xdg-desktop-portal.service 2>/dev/null || true
fi
exec systemctl --user start --no-block "chora-$name.target"
