#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Runs xwayland-satellite on a free X11 display and gives DISPLAY to the
# units of the session, so that X11 programs work in chora (D26).
set -eu

n=0
while [ -e "/tmp/.X11-unix/X$n" ] || [ -e "/tmp/.X$n-lock" ]; do
    n=$((n + 1))
done

systemctl --user set-environment "DISPLAY=:$n"
if command -v dbus-update-activation-environment >/dev/null; then
    dbus-update-activation-environment "DISPLAY=:$n"
fi
exec xwayland-satellite ":$n"
