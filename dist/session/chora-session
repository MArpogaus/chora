#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Starts a chora session from a display manager: chora runs as the systemd
# user service chora@FLAVOR.service, and this script waits until it ends.
# Usage: chora-session [FLAVOR]   (default: tiling)
set -eu

flavor=${1:-tiling}

if systemctl --user -q is-active 'chora@*.service'; then
    echo "chora-session: chora runs already" >&2
    exit 1
fi

# The keyboard layout of the system, as under uwsm.
if [ -r /etc/xdg/uwsm/env-chora ]; then
    # shellcheck source=env-chora
    . /etc/xdg/uwsm/env-chora
fi

# The units of the session get the environment of the login.
systemctl --user reset-failed
systemctl --user import-environment
if command -v dbus-update-activation-environment >/dev/null; then
    dbus-update-activation-environment --all
fi

systemctl --user --wait start "chora@$flavor.service" || true

# Stop the units of the session, and forget its variables.
systemctl --user start --job-mode=replace-irreversibly chora-shutdown.target
systemctl --user unset-environment WAYLAND_DISPLAY CHORA_SOCKET DISPLAY \
    CHORA_FLAVOR_DIR XDG_CURRENT_DESKTOP XDG_SESSION_TYPE
