#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Bundles what a problem report needs into one .tar.gz that the person
# reads and then sends by hand: the versions, the log files of
# $XDG_STATE_HOME/chora/logs, the journal of the chora units of this
# boot, and the settings files of $XDG_CONFIG_HOME/chora. Nothing is
# uploaded. Every file is scrubbed before it goes into the bundle: the
# home path becomes ~, the user name USER, the host name HOST, and the
# value of each key such as token, secret, password, api_key, Api-Key or
# authorization, with the indented lines below it, and each string that
# looks like a token, (hidden). Settings files that are symlinks go in
# as the files they point to. Only the person reads the bundle.
# Usage: chora-report [-o FILE]
#   -o FILE   the bundle (default: ./chora-report-DATE.tar.gz)
set -eu
umask 077

out=
while [ $# -gt 0 ]; do
    case $1 in
    -o)
        out=${2:?usage: chora-report [-o FILE]}
        shift 2
        ;;
    -h | --help)
        sed -n '3,15p' "$0" | sed 's/^# \{0,1\}//'
        exit 0
        ;;
    *)
        echo "usage: chora-report [-o FILE]" >&2
        exit 2
        ;;
    esac
done
[ -n "$out" ] || out=$PWD/chora-report-$(date -u +%Y%m%dT%H%M%SZ).tar.gz

home=${HOME:?chora-report: no HOME}
state=${XDG_STATE_HOME:-$home/.local/state}
config=${XDG_CONFIG_HOME:-$home/.config}
user=$(id -un)
host=$(uname -n)

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
bundle=$work/chora-report
mkdir -p "$bundle/logs" "$bundle/config"

version() {
    if command -v "$1" >/dev/null; then
        printf '%s: %s\n' "$1" "$("$1" --version 2>&1 | head -n 1)"
    else
        printf '%s: not installed\n' "$1"
    fi
}

{
    for program in chora choractl chora-voice; do
        version "$program"
    done
    printf 'kernel: %s\n' "$(uname -srm)"
    if [ -r /etc/os-release ]; then
        printf 'system: %s\n' "$(. /etc/os-release && echo "${PRETTY_NAME:-$NAME}")"
    fi
    printf 'session: %s %s\n' "${XDG_SESSION_TYPE:-?}" "${XDG_CURRENT_DESKTOP:-?}"
    printf 'flavor: %s\n' "${CHORA_FLAVOR_DIR:-?}"
} >"$bundle/versions.txt"

if [ -d "$state/chora/logs" ]; then
    find "$state/chora/logs" -maxdepth 1 -type f -name '*.log*' -exec cp {} "$bundle/logs/" \;
fi

if command -v journalctl >/dev/null; then
    journalctl --user --boot --no-pager -o short-iso -u 'chora*' \
        >"$bundle/journal.txt" 2>&1 || true
fi

if [ -d "$config/chora" ]; then
    cp -RL "$config/chora/." "$bundle/config/" 2>/dev/null ||
        echo "chora-report: some settings files could not be read" >&2
    find "$bundle/config" -type f ! \( -name '*.yaml' -o -name '*.yml' -o -name '*.toml' \
        -o -name '*.json' -o -name '*.conf' -o -name '*.ini' \) -exec rm -f {} +
fi

secret='(token|secret|password|passwd|api[-_]?key|authorization|headers)'

quote() {
    printf '%s' "$1" | sed 's/[][\.*^$/+?(){}|]/\\&/g'
}

name() {
    printf '%s' "s/(^|[^[:alnum:]_.-])$(quote "$1")([^[:alnum:]_-]|$)/\\1$2\\2/g"
}

hide_blocks() {
    awk -v secret="$secret" -v q="'" '
        function indent(line) { match(line, /^[ \t]*/); return RLENGTH }
        hiding && (/^[ \t]*$/ || indent($0) > depth || (indent($0) == depth && $0 ~ /^[ \t]*-/)) {
            sub(/[^ \t].*/, "(hidden)")
            print
            next
        }
        { hiding = 0 }
        tolower($0) ~ "^[ \t]*(- )?[\"" q "]?[[:alnum:]_-]*" secret "[[:alnum:]_-]*[\"" q "]?[ \t]*:" {
            hiding = 1
            depth = indent($0)
        }
        { print }
    ' "$1"
}

scrub() {
    hide_blocks "$1" | sed -E \
        -e "s/$(quote "$home")/~/g" \
        -e "$(name "$user" USER)" -e "$(name "$user" USER)" \
        -e "$(name "$host" HOST)" -e "$(name "$host" HOST)" \
        -e 's/(["'\'']?[[:alnum:]_-]*'"$secret"'[[:alnum:]_-]*["'\'']?[[:space:]]*[:=][[:space:]]*).*/\1(hidden)/I' \
        -e 's/(Bearer|Basic|token)[[:space:]]+[[:alnum:]._~+\/=-]+/\1 (hidden)/Ig' \
        -e 's/(sk|pk|rk)-[[:alnum:]_-]{8,}/(hidden)/g' \
        -e 's/(ghp|gho|ghu|ghs|ghr|github_pat|glpat|xox[abpr])[-_][[:alnum:]_-]{8,}/(hidden)/g' \
        -e 's/[[:alnum:]_+\/=-]{40,}/(hidden)/g'
}

find "$bundle" -type f | while read -r file; do
    scrub "$file" >"$file.scrubbed"
    mv "$file.scrubbed" "$file"
done

tar -czf "$out" -C "$work" chora-report
echo "chora-report: $out"
echo "Read it before you send it: tar -xzf $out. Nothing was uploaded."
