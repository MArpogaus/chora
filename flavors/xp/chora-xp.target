# The XP flavor: chora-xp, a stacking window manager in the style of
# Windows XP, the notifications and the assistant with the XP assets, and
# X11 programs.
[Unit]
Description=The XP flavor of chora
BindsTo=graphical-session.target
After=graphical-session.target
Wants=chora-xp.service chora-xp-notify.service chora-xp-assistant.service chora-xp-xwayland.service
