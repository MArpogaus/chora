// The panel of the tiling flavor. Only modules that need no IPC of sway
// and only words of a person: the nine custom/tagN and custom/layout ask
// chora-tiling for the tags and the layout (tag.sh, layout.sh) when
// chora-tiling sends SIGRTMIN+1 to waybar after a change, at once, and every
// 5 seconds in case a signal is lost; custom/volume asks wpctl for the
// volume: a click mutes, the wheel changes it, and the tooltip says why
// there is no sound. waybar.sh starts waybar with this file on the
// outputs of chora-tiling only.
{
  "layer": "top",
  "position": "top",
  "height": 32,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  "modules-left": ["custom/apps", "custom/sep1", "custom/tag1", "custom/tag2", "custom/tag3", "custom/tag4", "custom/tag5", "custom/tag6", "custom/tag7", "custom/tag8", "custom/tag9", "custom/sep2", "custom/layout"],
  "modules-center": ["clock"],
  "modules-right": ["custom/volume", "network", "battery", "tray", "custom/sep3", "custom/keys", "custom/power"],
  "custom/tag1": {
    "exec": "sh \"$CHORA_FLAVOR_DIR/waybar/tag.sh\" 1",
    "return-type": "json",
    "interval": 5,
    "signal": 1,
    "on-click": "choractl call tiling view_tag '{\"tag\": 1}'",
    "tooltip": false
  },
  "custom/tag2": {
    "exec": "sh \"$CHORA_FLAVOR_DIR/waybar/tag.sh\" 2",
    "return-type": "json",
    "interval": 5,
    "signal": 1,
    "on-click": "choractl call tiling view_tag '{\"tag\": 2}'",
    "tooltip": false
  },
  "custom/tag3": {
    "exec": "sh \"$CHORA_FLAVOR_DIR/waybar/tag.sh\" 3",
    "return-type": "json",
    "interval": 5,
    "signal": 1,
    "on-click": "choractl call tiling view_tag '{\"tag\": 3}'",
    "tooltip": false
  },
  "custom/tag4": {
    "exec": "sh \"$CHORA_FLAVOR_DIR/waybar/tag.sh\" 4",
    "return-type": "json",
    "interval": 5,
    "signal": 1,
    "on-click": "choractl call tiling view_tag '{\"tag\": 4}'",
    "tooltip": false
  },
  "custom/tag5": {
    "exec": "sh \"$CHORA_FLAVOR_DIR/waybar/tag.sh\" 5",
    "return-type": "json",
    "interval": 5,
    "signal": 1,
    "on-click": "choractl call tiling view_tag '{\"tag\": 5}'",
    "tooltip": false
  },
  "custom/tag6": {
    "exec": "sh \"$CHORA_FLAVOR_DIR/waybar/tag.sh\" 6",
    "return-type": "json",
    "interval": 5,
    "signal": 1,
    "on-click": "choractl call tiling view_tag '{\"tag\": 6}'",
    "tooltip": false
  },
  "custom/tag7": {
    "exec": "sh \"$CHORA_FLAVOR_DIR/waybar/tag.sh\" 7",
    "return-type": "json",
    "interval": 5,
    "signal": 1,
    "on-click": "choractl call tiling view_tag '{\"tag\": 7}'",
    "tooltip": false
  },
  "custom/tag8": {
    "exec": "sh \"$CHORA_FLAVOR_DIR/waybar/tag.sh\" 8",
    "return-type": "json",
    "interval": 5,
    "signal": 1,
    "on-click": "choractl call tiling view_tag '{\"tag\": 8}'",
    "tooltip": false
  },
  "custom/tag9": {
    "exec": "sh \"$CHORA_FLAVOR_DIR/waybar/tag.sh\" 9",
    "return-type": "json",
    "interval": 5,
    "signal": 1,
    "on-click": "choractl call tiling view_tag '{\"tag\": 9}'",
    "tooltip": false
  },
  "custom/apps": {
    "exec": "echo '{\"text\": \"Apps\", \"tooltip\": \"Run a program (Super+Space)\"}'",
    "return-type": "json",
    "interval": "once",
    "on-click": "choractl run -- chora-tiling --launch fuzzel"
  },
  "custom/sep1": {"exec": "echo ' '", "interval": "once", "tooltip": false},
  "custom/sep2": {"exec": "echo ' '", "interval": "once", "tooltip": false},
  "custom/sep3": {"exec": "echo ' '", "interval": "once", "tooltip": false},
  "custom/layout": {
    "align": 0,
    "exec": "sh \"$CHORA_FLAVOR_DIR/waybar/layout.sh\"",
    "return-type": "json",
    "interval": 5,
    "signal": 1,
    "on-click": "choractl call tiling next_layout"
  },
  "custom/keys": {
    "exec": "echo '{\"text\": \"Keys\", \"tooltip\": \"Every key (Super+/)\"}'",
    "return-type": "json",
    "interval": "once",
    "on-click": "choractl call tiling show_keys"
  },
  "custom/power": {
    "exec": "echo '{\"text\": \" \", \"tooltip\": \"Power menu (Super+Shift+e)\"}'",
    "return-type": "json",
    "interval": "once",
    "on-click": "choractl run -- chora-tiling --launch power"
  },
  "clock": {
    "format": "{:%a %d %b %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "format": {"today": "<b><u>{}</u></b>"}
    }
  },
  "custom/volume": {
    "exec": "sh \"$CHORA_FLAVOR_DIR/waybar/volume.sh\"",
    "return-type": "json",
    "interval": 1,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },
  "network": {
    "format-wifi": "{essid}",
    "format-ethernet": "Connected",
    "format-disconnected": "Offline",
    "tooltip-format": "{ifname} {ipaddr}/{cidr}"
  },
  "battery": {
    "format": "Battery {capacity}%",
    "states": {"warning": 20, "critical": 10}
  },
  "tray": {
    "spacing": 8
  }
}
