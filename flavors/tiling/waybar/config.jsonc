// The panel of the tiling flavor. Only modules that need no IPC of sway
// and only words of a person: custom/tags asks chora-tiling each second
// for the tags of the output, and custom/volume asks wpctl for the
// volume: a click mutes, the wheel changes it, and the tooltip says why
// there is no sound. waybar.sh starts waybar with this file on the
// outputs of chora-tiling only.
{
  "layer": "top",
  "position": "top",
  "height": 26,
  "modules-left": ["custom/tags"],
  "modules-center": ["clock"],
  "modules-right": ["custom/volume", "network", "battery", "tray"],
  "custom/tags": {
    "exec": "choractl call tiling get_tags 2>/dev/null | jq -c -f \"$CHORA_FLAVOR_DIR/waybar/tags.jq\"",
    "return-type": "json",
    "interval": 1,
    "tooltip": false
  },
  "clock": {
    "format": "{:%a %d %b %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "custom/volume": {
    "exec": "sh \"$CHORA_FLAVOR_DIR/waybar/volume.sh\"",
    "return-type": "json",
    "interval": 1,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },
  "network": {
    "format-wifi": "{essid}",
    "format-ethernet": "Connected",
    "format-disconnected": "Offline",
    "tooltip-format": "{ifname} {ipaddr}/{cidr}"
  },
  "battery": {
    "format": "Battery {capacity}%",
    "states": {"warning": 20, "critical": 10}
  },
  "tray": {
    "spacing": 8
  }
}
