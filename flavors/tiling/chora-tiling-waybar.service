[Unit]
Description=waybar, the panel of the tiling flavor
PartOf=graphical-session.target
After=graphical-session.target chora-tiling.service
ConditionPathExists=/usr/bin/waybar

[Service]
# chora-flavor sets CHORA_FLAVOR_DIR. The style is the one of waybar.
# waybar.sh starts waybar on the outputs of chora-tiling only.
ExecStart=/bin/sh ${CHORA_FLAVOR_DIR}/waybar/waybar.sh ${CHORA_FLAVOR_DIR}/waybar
ExecReload=/bin/kill -SIGUSR2 $MAINPID
Restart=on-failure
RestartSec=1
