[Unit]
Description=swaybg, the wallpaper of the tiling flavor
PartOf=graphical-session.target
After=graphical-session.target
ConditionPathExists=/usr/bin/swaybg

[Service]
# chora-tiling --launch swaybg shows wallpaper.png in Ink, wallpaper-paper.png
# in Paper, or the wallpaper.png of the user in the chora/tiling folder of the
# config directory.
ExecStart=/usr/bin/chora-tiling --launch swaybg
Restart=on-failure
RestartSec=1
