[Unit]
Description=swayidle, the idle lock of the tiling flavor
PartOf=graphical-session.target
After=graphical-session.target
ConditionPathExists=/usr/bin/swayidle

[Service]
# swaylock locks through the session lock of the core: after 5 minutes
# without input, before sleep, and on `loginctl lock-session`.
# chora-tiling --launch starts it with swaylock.conf in the palette.
ExecStart=/usr/bin/swayidle -w timeout 300 '/usr/bin/chora-tiling --launch swaylock -f' before-sleep '/usr/bin/chora-tiling --launch swaylock -f' lock '/usr/bin/chora-tiling --launch swaylock -f'
Restart=on-failure
RestartSec=1
